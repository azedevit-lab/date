# Admin panel şifrəsi (minimum 8 simvol)
ADMIN_PASSWORD=change-me-please
# Session cookie-ni imzalamaq üçün təsadüfi uzun sətir (openssl rand -hex 32)
SESSION_SECRET=
PORT=3001
# nginx/caddy arxasındadırsa 1 yaz
TRUST_PROXY=1
# HTTPS olmadan (sadəcə http://IP:port) test edirsənsə 1 yaz, əks halda admin login işləməz
INSECURE_COOKIE=0
